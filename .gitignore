# Byte-compiled / optimized Python files
__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build outputs
build/
dist/
dist-linux/
dist-windows/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
pip-cache/
.cache/pip/
.cache/uv/
*.whl

# Test, type-checker and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Firmware images and native binaries.  Test ROMs are synthesised at runtime by
# tests/core/rom_fixtures.py and must never be checked in.
*.rom
*.bin
*.exe
*.dll
*.sys
*.efi
*.vbi
*.fv
*.cap
*.img
*.iso

# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.bak
